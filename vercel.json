{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/chaodefabrica",
      "destination": "/?acesso=chao"
    },
    {
      "source": "/chao",
      "destination": "/?acesso=chao"
    },
    {
      "source": "/qualidade",
      "destination": "/?acesso=qualidade"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
